{
  "version": 8,
  "name": "Indiana Jones local terrain fixture",
  "sources": {
    "dem": {
      "type": "raster-dem",
      "tiles": [
        "/synthetic-dem/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 14,
      "encoding": "mapbox",
      "attribution": "Synthetic DEM generated by Indiana Jones"
    }
  },
  "terrain": {
    "source": "dem",
    "exaggeration": 3
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#111820"
      }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "dem",
      "paint": {
        "hillshade-accent-color": "#142f36",
        "hillshade-highlight-color": "#ead9a5",
        "hillshade-shadow-color": "#132028",
        "hillshade-exaggeration": 0.85,
        "hillshade-illumination-direction": 315
      }
    }
  ]
}
